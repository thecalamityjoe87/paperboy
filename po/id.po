#, no-c-format
msgid "%b %-d, %Y"
msgstr "%-d %b %Y"

#. clock skew / future timestamp
#: src/utils/text/dateUtils.vala:102
msgid "Just now"
msgstr "Baru saja"

#. TRANSLATORS: compact relative times on article cards, where space
#. is tight - abbreviate if your language allows it
#: src/utils/text/dateUtils.vala:106
#, c-format
msgid "%dm ago"
msgid_plural "%dm ago"
msgstr[0] "%d mnt lalu"

#: src/utils/text/dateUtils.vala:108
#, c-format
