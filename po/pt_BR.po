#: src/utils/text/dateUtils.vala:126
#, no-c-format
msgid "%A, %B %-d"
msgstr "%A, %-d de %B"

#. Weekday and numeric date for game times, e.g. "Mon 10/5".
#. TRANSLATORS: weekday and date on sports score cards, a strftime
